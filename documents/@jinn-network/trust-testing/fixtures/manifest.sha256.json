  "errata": [
    {
      "id": "resolution-v1/README.md",
      "supersededBy": "key-authority-v1/README.md",
      "date": "2026-11-02",
      "reason": "The superseded README describes a key rotation with adjacent validFrom and validTo windows. A key binding has no validTo field, and under the key authority text the old binding must still be in window when the new one takes effect, because it is the new binding's authority. The superseding README states the rule, and the vector incumbent-expiring-at-the-mint pins it. The original is retained unedited."
    }
  ]
