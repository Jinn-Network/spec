{
  "name": "ceremony-the-verifier-cannot-check",
  "description": "A binding whose ceremony the verifier has no means to check does not resolve and still counts for what came first.",
  "bindings": [
    {
      "id": "g",
      "key": "K1",
      "voucher": "A",
      "from": "01-01",
      "ceremony": "oidc-machine"
    },
    {
      "id": "x",
      "key": "K5",
      "voucher": "C",
      "from": "02-01"
    }
  ],
  "checks": [
    {
      "key": "K5",
      "expect": "consent-chain-violation"
    },
    {
      "key": "K1",
      "expect": "binding-not-resolved"
    }
  ]
}
